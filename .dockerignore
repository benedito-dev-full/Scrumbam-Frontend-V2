# Artefatos de build e dependências — nunca copiar para o context.
# Sem isso, COPY . . arrasta .next/node_modules antigos e o cache do Docker
# pode não refletir mudanças reais no código-fonte.
node_modules
.next
.git
.gitignore

# Ambiente / segredos
.env*.local

# Editor / SO
.vscode
.idea
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude / ferramentas locais
.claude
workspace
